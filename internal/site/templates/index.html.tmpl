<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">skill-repo-store</a>
    <div class="search-shell">
      <label class="visually-hidden" for="search-input">Search skills</label>
      <input id="search-input" class="search-input" type="search" placeholder="Search skills by name or description…" autocomplete="off">
    </div>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" aria-label="Toggle dark mode">
      <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
      </svg>
    </button>
  </header>

  <main class="site-main">
    <p id="load-error" class="load-error" hidden>Could not load skill data — search and details are unavailable. Try reloading the page.</p>
    <p id="no-results" class="no-results" hidden></p>
    <div id="card-grid" class="card-grid" data-total="{{len .Skills}}">
      {{range .Skills}}
      <a class="card" href="#{{.DirName}}" data-skill="{{.DirName}}">
        <div class="card-head">
          <span class="card-name">{{.Name}}</span>
          {{range .Badges}}<span class="badge" title="{{.Key}}">{{.Value}}</span>{{end}}
        </div>
        <p class="card-description">{{.Description}}</p>
        <span class="card-dirname">{{.DirName}}</span>
      </a>
      {{end}}
    </div>
  </main>

  <footer class="site-footer">
    <p>Generated statically from a directory of Claude Code skills.</p>
  </footer>

  <div id="panel-backdrop" class="panel-backdrop" hidden></div>
  <aside id="skill-panel" class="skill-panel" role="dialog" aria-modal="true" aria-labelledby="panel-name" tabindex="-1" hidden>
    <div class="panel-header">
      <div>
        <h2 id="panel-name" class="panel-name"></h2>
        <p id="panel-dirname" class="panel-dirname"></p>
      </div>
      <button id="panel-close" class="panel-close" type="button" aria-label="Close">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
    <div class="panel-body">
      <p id="panel-description" class="panel-description"></p>
      <section id="panel-metadata-section" class="metadata" hidden aria-label="Skill metadata">
        <table class="metadata-table">
          <tbody id="panel-metadata-body"></tbody>
        </table>
      </section>
    </div>
    <div class="panel-actions">
      <a id="panel-download" class="button button-primary" download>Download .zip</a>
      <div class="install-block">
        <p class="install-label">Install with npx</p>
        <div class="install-command-row">
          <pre id="install-cmd" class="install-cmd"></pre>
          <button id="copy-cmd" class="button button-ghost copy-button" type="button" aria-label="Copy install command">Copy</button>
        </div>
      </div>
    </div>
  </aside>

  <script src="/assets/fuse.min.js"></script>
  <script src="/assets/app.js"></script>
</body>
</html>
